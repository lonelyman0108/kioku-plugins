#!/usr/bin/env node
// kioku 命令的入口，实现在 ../lib/kioku.mjs。插件启用期间，Claude Code 把插件的 bin/ 加进 Bash 工具的 PATH。
// 没有扩展名的文件按 CommonJS 还是 ES 模块执行，取决于 Node 的版本与上层的 package.json，
// 所以这里只用两边都能用的写法：动态 import，位置从 process.argv[1] 推
const load = (name) =>
  Promise.all([import('node:fs'), import('node:path'), import('node:url')]).then(
    ([fs, path, url]) => {
      const lib = path.join(path.dirname(fs.realpathSync(process.argv[1])), '..', 'lib')
      return import(url.pathToFileURL(path.join(lib, name)).href)
    },
  )

// 输出被读的一方提前关掉（kioku doctor | head）：之后的输出写不出去就算了，不抛一段堆栈；
// 手上的事照常做完、按它的结果退出（中途停下的话，写了一半的导入、配置会被当成成功）。别的写入错误照旧抛。
// run 不在此列：它转发命令的输出，自己处理这种情况
if (process.argv[2] !== 'run') {
  for (const stream of [process.stdout, process.stderr]) {
    stream.on('error', (err) => {
      if (!err || err.code !== 'EPIPE') throw err
    })
  }
}

load('kioku.mjs')
  .then((cli) => cli.main(process.argv.slice(2)))
  .then((code) => {
    process.exitCode = code
  })
  .catch((err) => {
    process.exitCode = 2
    // 只给错误类别：错误文字里可能带着环境变量的值。取不到共用的函数时只说一句固定的
    return load('http.mjs').then(
      ({ errorKind }) => process.stderr.write(`kioku：内部错误（${errorKind(err)}）\n`),
      () => process.stderr.write('kioku：内部错误\n'),
    )
  })
