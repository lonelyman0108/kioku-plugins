{
  "description": "会话开始时注入 Kioku 启动加载的内容，每轮输入时注入召回候选，每轮回复后把这一轮交给 Kioku 写会话摘要",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/forward.mjs", "session.start"],
            "timeoutMs": 10000,
            "statusMessage": "读取 Kioku 的启动加载"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/forward.mjs", "prompt.submit"],
            "timeoutMs": 10000,
            "statusMessage": "召回 Kioku 相关记忆"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "process",
            "command": "node",
            "args": ["${ZCODE_PLUGIN_ROOT}/hooks/forward.mjs", "turn.end"],
            "timeoutMs": 10000
          }
        ]
      }
    ]
  }
}
