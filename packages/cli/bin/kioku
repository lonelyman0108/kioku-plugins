#!/usr/bin/env node
// kioku 命令的入口，优先加载构建产物 ../dist/index.mjs；开发/源码直跑场景下回退到 ../src/index.ts。
// 没有扩展名的文件按 CommonJS 还是 ES 模块执行取决于上层 package.json，所以这里只用动态 import，位置从 process.argv[1] 推
const loadEntry = () =>
  Promise.all([import('node:fs'), import('node:path'), import('node:url')]).then(
    ([fs, path, url]) => {
      const root = path.join(path.dirname(fs.realpathSync(process.argv[1])), '..')
      const built = path.join(root, 'dist', 'index.mjs')
      const entry = fs.existsSync(built) ? built : path.join(root, 'src', 'index.ts')
      return import(url.pathToFileURL(entry).href)
    },
  )

// 输出被读的一方提前关掉（kioku doctor | head）：之后的输出写不出去就算了，不抛一段堆栈；
// 手上的事照常做完、按它的结果退出（中途停下的话，写了一半的导入、配置会被当成成功）。别的写入错误照旧抛。
// run 不在此列：它转发命令的输出，自己处理这种情况
if (process.argv[2] !== 'run') {
  for (const stream of [process.stdout, process.stderr]) {
    stream.on('error', (err) => {
      if (!err || err.code !== 'EPIPE') throw err
    })
  }
}

loadEntry()
  .then((cli) => cli.main(process.argv.slice(2)))
  .then((code) => {
    process.exitCode = code
  })
  .catch((err) => {
    process.exitCode = 2
    // 只给错误类别：错误文字里可能带着环境变量的值
    const kind =
      err && typeof err === 'object' && typeof err.code === 'string' && err.code
        ? err.code
        : err && typeof err.name === 'string' && err.name
          ? err.name
          : 'Error'
    process.stderr.write(`kioku：内部错误（${kind}）\n`)
  })
